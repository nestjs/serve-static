{
  "name": "@nestjs/serve-static",
  "version": "12.0.0",
  "description": "Nest - modern, fast, powerful node.js web framework (@serve-static)",
  "author": "Kamil Mysliwiec",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23.0.0"
  },
  "scripts": {
    "build": "npm run build:lib",
    "build:lib": "tsc -p tsconfig.json",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "oxlint lib/ --fix",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "prerelease": "npm run build",
    "release": "release-it",
    "test:e2e": "vitest run",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@fastify/static": "^10.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "express": "^5.0.1",
    "fastify": "^5.2.1"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "@fastify/static": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-angular": "21.2.3",
    "@fastify/static": "10.1.5",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/platform-fastify": "12.1.0",
    "@nestjs/testing": "12.1.0",
    "@types/node": "24.19.0",
    "@types/supertest": "7.2.1",
    "express": "5.2.1",
    "fastify": "5.12.5",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "oxlint": "^1.60.0",
    "prettier": "3.9.9",
    "reflect-metadata": "0.2.2",
    "release-it": "21.1.0",
    "rxjs": "7.8.2",
    "supertest": "7.3.0",
    "typescript": "~7.0.0",
    "vite": "^8.0.8",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nestjs/serve-static"
  },
  "dependencies": {
    "path-to-regexp": "8.4.2"
  }
}
